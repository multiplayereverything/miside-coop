<Project Sdk="Microsoft.NET.Sdk">
  <!-- BepInEx 6 (Unity.IL2CPP) plugin. Build with scripts/build.ps1; references come from the game's own BepInEx
       folder, so launch the game once with BepInEx installed to generate BepInEx/interop first. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MiSideTogether</AssemblyName>
    <RootNamespace>MiSideTogether</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>artifacts\build\</OutputPath>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)..</GameDir>
    <NoWarn>$(NoWarn);CS0414;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="artifacts\**;private\**;deps\**;graphify-out\**" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll" Private="false" />
    <!-- Generated by scripts/build.ps1 from the user's own game data (tools/extract_animator_params.py). -->
    <EmbeddedResource Include="artifacts\generated\animator-params.tsv" LogicalName="MiSideTogether.animator-params.tsv" />
  </ItemGroup>
</Project>
